+
+/// Capture stored RowBreak frame boundaries before text or paragraph insertion changes
+/// the neighboring line origins. Pasted paragraphs belong to the destination frame.
+pub(super) fn remember_cell_vpos_resets(paragraphs: &mut [Paragraph]) {
+    for idx in 1..paragraphs.len() {
+        let reset = cell_vpos_resets(&paragraphs[idx - 1], &paragraphs[idx]);
+        paragraphs[idx].cell_vpos_reset = Some(reset);
+    }
+}
+
+/// Removing a blank separator must not replace the following body's paragraph
+/// style with that blank line's compact spacing. Keep undo data for both sides.
+fn merge_cell_paragraph_with_format(
+    previous: &mut Paragraph,
+    next: &Paragraph,
+    para_shapes: &[crate::model::style::ParaShape],
+) -> (usize, ParaMeta) {
+    let mut removed_meta = next.capture_meta();
+    let empty_prefix =
+        previous.text.is_empty() && previous.controls.is_empty() && !next.text.is_empty();
+    if empty_prefix {
+        removed_meta.empty_prefix_format = Some(EmptyPrefixFormat {
+            para_shape_id: previous.para_shape_id,
+            style_id: previous.style_id,
+            char_shapes: previous
+                .char_shapes
+                .iter()
+                .map(|shape| (shape.start_pos, shape.char_shape_id))
+                .collect(),
+        });
+        // Retain the surviving paragraph identity and explicit break metadata.
+        let mut format = previous.capture_meta();
+        format.para_shape_id = next.para_shape_id;
+        format.style_id = next.style_id;
+        restore_para_meta(previous, format, para_shapes);
+    }
+    let offset = previous.merge_from(next);
+    if empty_prefix {
+        previous.char_shapes = next.char_shapes.clone();
+    }
+    (offset, removed_meta)
+}
+
+fn empty_prefix_restore(
+    meta: &Option<ParaMeta>,
+    para_shapes: &[crate::model::style::ParaShape],
+) -> Option<(EmptyPrefixFormat, i32, i32)> {
+    let meta = meta.as_ref()?;
+    let format = meta.empty_prefix_format.as_ref()?;
+    let indent = |id: u16| {
+        para_shapes
+            .get(usize::from(id))
+            .map_or(0, |shape| shape.indent)
+    };
+    Some((
+        format.clone(),
+        indent(meta.para_shape_id),
+        indent(format.para_shape_id),
+    ))
+}
+
+fn restore_empty_prefix(paragraph: &mut Paragraph, restore: &(EmptyPrefixFormat, i32, i32)) {
+    let (format, old_indent, new_indent) = restore;
+    paragraph.para_shape_id = format.para_shape_id;
+    paragraph.style_id = format.style_id;
+    paragraph.char_shapes = format
+        .char_shapes
+        .iter()
+        .map(|&(start_pos, char_shape_id)| CharShapeRef {
+            start_pos,
+            char_shape_id,
+        })
+        .collect();
+    crate::renderer::composer::restamp_indentation(
+        &mut paragraph.line_segs,
+        *old_indent,
+        *new_indent,
+    );
 }
 
